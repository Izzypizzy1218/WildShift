<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Library</OutputType>
    <AssemblyName>WildShiftCombatPerformance</AssemblyName><LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath><GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(GameDir)\UnityStubs.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyPath)" Private="false" />
    <Reference Include="WildShift" HintPath="$(WildShiftPath)" Private="false" />
    <Compile Include="CombatProbe.cs" />
    <Compile Include="ForceSpeedObserver.cs" />
    <Compile Include="FrameProbe.cs" />
    <Compile Include="StressLoadout.cs" />
    <Compile Include="SharedRefreshProbe.cs" />
    <Compile Include="LiveCombat.cs" />
    <Compile Include="SelectionProbe.cs" />
    <Compile Include="SelectionDetailsProbe.cs" />
  </ItemGroup>
</Project>
