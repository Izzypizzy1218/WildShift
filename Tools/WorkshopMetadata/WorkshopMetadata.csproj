<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WorkshopMetadata</AssemblyName>
    <Nullable>disable</Nullable>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <SteamworksPath Condition="'$(SteamworksPath)' == ''">$(RimWorldDir)\com.rlabrecque.steamworks.net.dll</SteamworksPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(SteamworksPath)" />
  </ItemGroup>
  <Target Name="ValidateInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SteamworksPath)')" Text="Supply -p:RimWorldDir=... or -p:SteamworksPath=... for the installed Steamworks.NET assembly." />
  </Target>
</Project>
